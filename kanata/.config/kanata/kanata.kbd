;; Home row mods modeled on hrm (github.com/sarfata/hrm): "timeless" tap-hold
;; where hold vs. tap is decided by other key activity, not by a timer.
;;
;;   tap  = press and release with nothing else happening -> letter
;;   hold = press and release another key while held      -> modifier
;;
;; Same-hand home row keys never decide (no misfires on rolls like "as"/"df"),
;; so same-hand mods still stack: hold a+s, then press a right-hand key.
;; Caps Lock = Escape.
;; Space held + h/j/k/l = arrows, , . = word left/right, Caps Lock = delete word.
;;
;; Esc switches to plain mode (a normal keyboard, no home row mods).
;; In plain mode, tap Esc = Escape, hold Esc = back to home row mods.
;;
;; Panic exit: LCtrl + Space + Esc.

(defcfg
  process-unmapped-keys yes
  concurrent-tap-hold yes
  tap-hold-require-prior-idle 150  ;; typed within 150ms -> always the letter
)

;; Only home row keys get a hand, like hrm; any other key resolves a hold.
(defhands
  (left  a s d f g)
  (right h j k l ;))

(defvar
  forever 65535      ;; no hold timer in practice; an unresolved key times out as a tap
  quick-tap 150      ;; re-press within 150ms after a tap -> letter (for "ll", "ss")
)

;; Modifier order (mirrored on the right hand).
(platform (macos)
  (defvar pinky lctl  ring lalt  middle lmet  index lsft))
(platform (win winiov2 wintercept linux)
  (defvar pinky lmet  ring lalt  middle lctl  index lsft))

(deftemplate hrm (key mod)
  (tap-hold-opposite-hand-release $forever $key $mod
    (timeout tap)
    (same-hand ignore)
    (unknown-hand hold)
    (tap-repress-timeout $quick-tap))
)

(defalias
  a (t! hrm a $pinky)
  s (t! hrm s $ring)
  d (t! hrm d $middle)
  f (t! hrm f $index)
  j (t! hrm j $index)
  k (t! hrm k $middle)
  l (t! hrm l $ring)
  ; (t! hrm ; $pinky)

  ;; Space: tap = space, hold (another key pressed and released) = nav layer.
  spc (tap-hold-release $quick-tap $forever spc (layer-while-held nav))

  plain (layer-switch plain)
  ;; Timer-based on purpose; prior-idle off so it works right after typing.
  to-hrm (tap-hold 300 300 esc (layer-switch base) (require-prior-idle 0))
)

(defsrc
  esc caps
  a s d f   h j k l ;
  , .
  spc
)

(deflayer base
  @plain esc
  @a @s @d @f   h @j @k @l @;
  , .
  @spc
)

;; Left home row is plain modifiers here so selection is instant (space+f+h = shift+left).
(deflayer nav
  _ C-bspc
  $pinky $ring $middle $index   left down up right _
  C-left C-right
  _
)

(deflayer plain
  @to-hrm caps
  a s d f   h j k l ;
  , .
  spc
)
