;; Home row mods modeled on hrm (github.com/sarfata/hrm): "timeless" tap-hold
;; where hold vs. tap is decided by other key activity, not by a timer.
;;
;;   tap  = press and release with nothing else happening -> letter
;;   hold = press and release another key while held      -> modifier
;;
;; Same-hand home row keys never decide (no misfires on rolls like "as"/"df"),
;; so same-hand mods still stack: hold a+s, then press a right-hand key.
;; Caps Lock = Escape (in both base and plain); hold it 3 seconds = real Caps Lock.
;; Space held + h/j/k/l = arrows, , . = word left/right, Caps Lock = delete word,
;;   i/o = next/prev tab, q = close app (Alt+F4), w = Ctrl+W, n/m = page down/up,
;;   g = Home, ; = End.
;;
;; Esc = Escape. Hold Esc 1 second = toggle between base and plain mode (a normal
;; keyboard, no home row mods). kanata-modes.py remembers the mode per app.
;; Both modes: Right Alt = previous workspace, hold Right Ctrl 0.5s = quit app.
;;
;; Panic exit: LCtrl + Space + Esc.

(defcfg
  process-unmapped-keys yes
  concurrent-tap-hold yes
  tap-hold-require-prior-idle 150  ;; typed within 150ms -> always the letter
)

;; Only home row keys get a hand, like hrm; any other key resolves a hold.
(defhands
  (left  a s d f g)
  (right h j k l ;))

(defvar
  forever 65535      ;; no hold timer in practice; an unresolved key times out as a tap
  quick-tap 150      ;; re-press within 150ms after a tap -> letter (for "ll", "ss")
)

;; Modifier order (mirrored on the right hand).
(platform (macos)
  (defvar pinky lctl  ring lalt  middle lmet  index lsft))
(platform (win winiov2 wintercept linux)
  (defvar pinky lmet  ring lalt  middle lctl  index lsft))

(deftemplate hrm (key mod)
  (tap-hold-opposite-hand-release $forever $key $mod
    (timeout tap)
    (same-hand ignore)
    (unknown-hand hold)
    (tap-repress-timeout $quick-tap))
)

(defalias
  a (t! hrm a $pinky)
  s (t! hrm s $ring)
  d (t! hrm d $middle)
  f (t! hrm f $index)
  j (t! hrm j $index)
  k (t! hrm k $middle)
  l (t! hrm l $ring)
  ; (t! hrm ; $pinky)

  ;; Space: tap = space, hold (another key pressed and released) = nav layer.
  spc (tap-hold-release $quick-tap $forever spc (layer-while-held nav))

  ;; Tap = Escape, hold 1s = switch mode.
  plain (tap-hold 1000 1000 esc (layer-switch plain) (require-prior-idle 0))
  to-hrm (tap-hold 1000 1000 esc (layer-switch base) (require-prior-idle 0))

  ;; Previous workspace (Meta+Alt+, in KWin and GlazeWM) and a quit that
  ;; needs a 0.5s hold, so a stray tap in a game doesn't close it.
  prevws M-A-,
  quit (tap-hold 500 500 rctl A-f4 (require-prior-idle 0))

  ;; Tap = Escape (on release), hold 3s = Caps Lock.
  ;; Prior-idle off so the hold still works right after typing.
  caps (tap-hold 3000 3000 esc caps (require-prior-idle 0))
)

(defsrc
  esc caps
  q w   i o
  a s d f g   h j k l ;
  n m , .
  spc ralt rctl
)

(deflayer base
  @plain @caps
  q w   i o
  @a @s @d @f g   h @j @k @l @;
  n m , .
  @spc @prevws @quit
)

;; Left home row is plain modifiers here so selection is instant (space+f+h = shift+left).
(deflayer nav
  _ C-bspc
  A-f4 C-w   C-tab C-S-tab
  $pinky $ring $middle $index home   left down up right end
  pgdn pgup C-left C-right
  _ _ _
)

(deflayer plain
  @to-hrm @caps
  q w   i o
  a s d f g   h j k l ;
  n m , .
  spc @prevws @quit
)
